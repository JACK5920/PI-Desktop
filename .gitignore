# Test scratch trees. Each is removed by its own teardown; these lines only
# keep an interrupted run from polluting `git status`. They are also listed in
# `electron.vite.config.ts` so the dev watcher never opens a live Chromium
# profile — an EBUSY there takes the whole dev process down.
.artifacts/
apps/desktop/.isolated-launch-test-*/
apps/desktop/.jev-service-ui-*/
.playwright-mcp/
.claude/
.workbuddy
electron.vite.config.*.mjs

.playwright-cli
worktrees

# Local hardening-run artifacts (dev data dirs, Chromium profiles, machine keys).
# These are per-machine runtime state, not sources: they must never be
# committed, and an external tool that stages the whole tree before switching
# branches would otherwise sweep the dev SQLite database and the local
# machine key into a commit.
.artifacts/
